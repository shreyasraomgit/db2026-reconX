<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV052 — Hibernate Envers audit tables for Trade

 WHAT:    revinfo (one row per committed revision) and trades_aud (one row
          per revision per trade, mirroring the trades columns plus rev /
          revtype) — the two tables Envers writes to when @Audited fires.
 HOW:     ddl-auto is "validate", so Hibernate never creates these tables
          itself; Liquibase must lay them out to match exactly what Envers
          expects for the DefaultRevisionEntity + @Audited Trade shape.
 WHY:     Without this changeset the app boots fine (Envers only touches
          these tables on write) but the very first INSERT into trades_aud
          fails with "table not found" the moment @Audited is re-enabled.
 OBSERVE: After three updates to a trade, `SELECT * FROM trades_aud WHERE id = ?`
          returns 4 rows (1 insert + 3 updates); revinfo has a matching REV
          per row with a timestamp.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="009-create-revinfo" author="trainer">
        <createTable tableName="revinfo">
            <column name="rev" type="INT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="revtstmp" type="BIGINT"/>
        </createTable>
        <rollback>
            <dropTable tableName="revinfo"/>
        </rollback>
    </changeSet>

    <!--
     TICKET-ADV052 follow-up — Postgres hides IDENTITY-owned sequences from
     information_schema.sequences (SQL-standard behaviour), so Hibernate
     Envers' SEQUENCE-strategy revinfo generator fails schema validation
     ("missing sequence [revinfo_seq]") even though the identity column
     works fine functionally. H2 (dev) is unaffected, hence dbms="postgresql".
     Fix: give revinfo.rev a real standalone sequence Hibernate can see.
     incrementBy=50 matches Hibernate's SequenceStyleGenerator default
     allocationSize — a mismatched increment fails with a MappingException
     at boot ("increment size ... set to [50] ... database ... is [1]").
    -->
    <changeSet id="009-fix-revinfo-sequence-postgres" author="trainer" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="revinfo_seq"/>
            </not>
        </preConditions>
        <createSequence sequenceName="revinfo_seq" startValue="1" incrementBy="50"/>
        <sql>
            ALTER TABLE revinfo ALTER COLUMN rev DROP IDENTITY IF EXISTS;
            ALTER TABLE revinfo ALTER COLUMN rev SET DEFAULT nextval('revinfo_seq');
            ALTER SEQUENCE revinfo_seq OWNED BY revinfo.rev;
            SELECT setval('revinfo_seq', COALESCE((SELECT MAX(rev) FROM revinfo), 0) + 1, false);
        </sql>
        <rollback>
            <sql>ALTER TABLE revinfo ALTER COLUMN rev DROP DEFAULT;</sql>
            <dropSequence sequenceName="revinfo_seq"/>
        </rollback>
    </changeSet>

    <changeSet id="009-create-trades-aud" author="trainer">
        <createTable tableName="trades_aud">
            <column name="id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="rev" type="INT"><constraints nullable="false"/></column>
            <column name="revtype" type="SMALLINT"/>
            <column name="trade_ref" type="VARCHAR(30)"/>
            <column name="instrument_id" type="BIGINT"/>
            <column name="counterparty_id" type="BIGINT"/>
            <column name="asset_class" type="VARCHAR(20)"/>
            <column name="side" type="VARCHAR(4)"/>
            <column name="quantity" type="NUMERIC(18,4)"/>
            <column name="price" type="NUMERIC(18,4)"/>
            <column name="trade_date" type="DATE"/>
            <column name="status" type="VARCHAR(20)"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="modified_at" type="TIMESTAMP"/>
        </createTable>
        <addPrimaryKey tableName="trades_aud" columnNames="id, rev" constraintName="pk_trades_aud"/>
        <addForeignKeyConstraint baseTableName="trades_aud" baseColumnNames="rev"
                                 constraintName="fk_trades_aud_revinfo"
                                 referencedTableName="revinfo" referencedColumnNames="rev"/>
        <rollback>
            <dropTable tableName="trades_aud"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
